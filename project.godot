; Four Clans — PRODUCTION project (Godot 4.6).
; The throwaway prototype lives in prototypes/movement-and-combat/ (its own project,
; shielded from this one by a .gdignore). This project only scans src/, assets/, tests/, addons/.
; Engine/renderer/physics choices follow .claude/docs/technical-preferences.md.

config_version=5

[application]

config/name="Four Clans"
config/description="2D arena couch PvP, TowerFall-inspired. Production codebase (src/)."
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

; Autoload names differ from class_names to avoid Godot autoload/class_name clashes:
;   GameState  -> class GameStateManager   (per the GDD)
;   CouchInput -> class CouchInputSystem    (per the GDD)
; GameState is listed first so it exists when CouchInput._ready() looks it up.
GameState="*res://src/core/game_state_manager.gd"
CouchInput="*res://src/core/couch_input.gd"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[display]

; 480x270 internal pixel-art resolution (Map GDD Core Rule 3), scaled to the window with
; aspect-preserving letterbox. Default window = x2 (960x540).
window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=960
window/size/window_height_override=540
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[physics]

2d/physics_engine="GodotPhysics2D"

[rendering]

renderer/rendering_method="forward_plus"
